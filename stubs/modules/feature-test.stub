<?php

namespace App\Modules\{{MODULE}}\Tests\Feature;

use Tests\TestCase;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Foundation\Testing\WithFaker;
use App\Modules\{{MODULE}}\Models\{{MODULE}};

class {{MODULE}}Test extends TestCase
{
    use RefreshDatabase, WithFaker;

    protected User $user;

    protected function setUp(): void
    {
        parent::setUp();

        $this->user = User::factory()->create();
    }

    public function test_index_returns_paginated_{{MODULE_LOWER_PLURAL}}(): void
    {
        {{MODULE}}::factory()->count(5)->create();

        $response = $this->actingAs($this->user, 'api')
            ->getJson('/api/v1/{{MODULE_LOWER_PLURAL}}');

        $response->assertStatus(200)
            ->assertJsonStructure([
                'success',
                'message',
                'data' => [
                    '*' => ['id', 'uuid', 'created_at', 'updated_at']
                ],
                'meta' => [
                    'current_page',
                    'per_page',
                    'total',
                    'last_page',
                ],
            ]);
    }

    public function test_store_creates_new_{{MODULE_LOWER}}(): void
    {
        $data = [
            // Add test data here
        ];

        $response = $this->actingAs($this->user, 'api')
            ->postJson('/api/v1/{{MODULE_LOWER_PLURAL}}', $data);

        $response->assertStatus(201)
            ->assertJsonStructure([
                'success',
                'message',
                'data' => ['id', 'uuid', 'created_at', 'updated_at'],
            ]);

        $this->assertDatabaseHas('{{TABLE_NAME}}', [
            'uuid' => $response->json('data.uuid'),
        ]);
    }

    public function test_show_returns_specific_{{MODULE_LOWER}}(): void
    {
        ${{MODULE_LOWER}} = {{MODULE}}::factory()->create();

        $response = $this->actingAs($this->user, 'api')
            ->getJson("/api/v1/{{MODULE_LOWER_PLURAL}}/{${{MODULE_LOWER}}->uuid}");

        $response->assertStatus(200)
            ->assertJson([
                'success' => true,
                'data' => [
                    'uuid' => ${{MODULE_LOWER}}->uuid,
                ],
            ]);
    }

    public function test_update_modifies_{{MODULE_LOWER}}(): void
    {
        ${{MODULE_LOWER}} = {{MODULE}}::factory()->create();

        $data = [

        ];

        $response = $this->actingAs($this->user, 'api')
            ->putJson("/api/v1/{{MODULE_LOWER_PLURAL}}/{${{MODULE_LOWER}}->uuid}", $data);

        $response->assertStatus(200)
            ->assertJson([
                'success' => true,
            ]);

        ${{MODULE_LOWER}}->refresh();


    }

    public function test_destroy_deletes_{{MODULE_LOWER}}(): void
    {
        ${{MODULE_LOWER}} = {{MODULE}}::factory()->create();

        $response = $this->actingAs($this->user, 'api')
            ->deleteJson("/api/v1/{{MODULE_LOWER_PLURAL}}/{${{MODULE_LOWER}}->uuid}");

        $response->assertStatus(200)
            ->assertJson([
                'success' => true,
            ]);

        $this->assertSoftDeleted('{{TABLE_NAME}}', [
            'id' => ${{MODULE_LOWER}}->id,
        ]);
    }


    public function test_show_returns_404_for_non_existent_{{MODULE_LOWER}}(): void
    {
        $fakeUuid = $this->faker->uuid();

        $response = $this->actingAs($this->user, 'api')
            ->getJson("/api/v1/{{MODULE_LOWER_PLURAL}}/{$fakeUuid}");

        $response->assertStatus(404)
            ->assertJson([
                'success' => false,
                'message' => '{{MODULE}} not found',
            ]);
    }

    public function test_store_validates_required_fields(): void
    {
        $response = $this->actingAs($this->user, 'api')
            ->postJson('/api/v1/{{MODULE_LOWER_PLURAL}}', []);

        $response->assertStatus(422)
            ->assertJsonStructure([
                'success',
                'message',
                'errors',
            ]);
    }

    public function test_unauthenticated_user_cannot_access_endpoints(): void
    {
        $response = $this->getJson('/api/v1/{{MODULE_LOWER_PLURAL}}');

        $response->assertStatus(401);
    }
}